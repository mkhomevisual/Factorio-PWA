# Default local mode: no Factorio instance is required.
FACTORY_MODE=mock
APP_PORT=3000
SESSION_COOKIE_SECURE=false
DATABASE_PATH=/app/data/hal-factory-control.db
# Directory populated from a user-owned Factorio base-assets installation.
# It is intentionally not committed to Git.
FACTORIO_ICON_DIR=/app/data/factorio-icons

# Production only. Keep this hostname on the private factorio_default network.
FACTORIO_RCON_HOST=server
FACTORIO_RCON_PORT=27015
FACTORIO_LOG_PATH=/factorio/factorio-current.log
# The password is deliberately not an environment variable. It is mounted as a
# Docker Compose secret at /run/secrets/factorio_rcon_password.
RCON_PASSWORD_FILE=/run/secrets/factorio_rcon_password
