# Default local mode: no Factorio instance is required.
FACTORY_MODE=mock
APP_PORT=3000
SESSION_COOKIE_SECURE=false
DATABASE_PATH=/app/data/hal-factory-control.db
# Directory populated from a user-owned Factorio base-assets installation.
# It is intentionally not committed to Git.
FACTORIO_ICON_DIR=/app/data/factorio-icons

# Production only. Keep this hostname on the private factorio_default network.
FACTORIO_RCON_HOST=server
FACTORIO_RCON_PORT=27015
FACTORIO_LOG_PATH=/factorio/factorio-current.log
# The password is deliberately not an environment variable. It is mounted as a
# Docker Compose secret at /run/secrets/factorio_rcon_password.
RCON_PASSWORD_FILE=/run/secrets/factorio_rcon_password

# Safe mode: cached data only until a signed-in user clicks "Aktualizovat data".
HAL_BACKGROUND_SAMPLING_ENABLED=false
# Used only when background sampling is explicitly enabled; minimum is 5 min.
HAL_BACKGROUND_SAMPLING_INTERVAL_MS=300000
# Compatibility opt-in: one global refresh when the HAL backend starts, never per browser tab.
HAL_LIVE_RCON_ON_PAGE_LOAD=false
# Global refresh cooldown; values below 10 seconds are rejected.
HAL_REFRESH_COOLDOWN_MS=10000

# Production reverse-proxy values (copy into a local .env.production only).
VIRTUAL_HOST=factorio.mkdevs.cz
LETSENCRYPT_EMAIL=you@example.com
